rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly block all global/wildcard access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the carbon_logs collection
    match /carbon_logs/{documentId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // Rules for the ai_insights_cache collection
    // Cache documents are keyed by SHA-256 hash of user data.
    // Only authenticated users can read; writes are done via Admin SDK (server-side).
    match /ai_insights_cache/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;  // Only Admin SDK can write cache entries
    }
  }
}
