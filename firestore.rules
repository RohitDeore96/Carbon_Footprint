rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly block all global/wildcard access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the carbon_logs collection
    // Authenticated users can only access their own data (UID-scoped)
    match /carbon_logs/{documentId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // Rules for the ai_insights_cache collection
    // Cache entries are keyed by SHA-256 hash (no user data in key).
    // Only server-side (Admin SDK) writes are expected; client reads are
    // denied to prevent cache snooping. Admin SDK bypasses rules entirely.
    match /ai_insights_cache/{documentId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
