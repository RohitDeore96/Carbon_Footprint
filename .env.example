# =============================================================================
# Carbon Footprint Awareness Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running the application.

# -----------------------------------------------------------------------------
# Backend (FastAPI / Python)
# -----------------------------------------------------------------------------

# Google Cloud project ID (used by Firebase Admin SDK and Vertex AI)
GOOGLE_CLOUD_PROJECT=your-project-id

# Path to a service-account JSON key file for Firebase Admin / Google Cloud ADC.
# Required when running the backend locally; on Cloud Run ADC is automatic.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Vertex AI / Gemini configuration
# This project uses the `google-genai` Python SDK (NOT `google-cloud-aiplatform`)
# to access Gemini models. The google-genai SDK supports two authentication modes:
#
#   1. AI Studio API key  — set GOOGLE_API_KEY below (default).
#   2. Vertex AI endpoint  — set GOOGLE_GENAI_USE_VERTEXAI=true and rely on
#      GOOGLE_APPLICATION_CREDENTIALS / Application Default Credentials.
#
# When using the Vertex AI endpoint the google-genai SDK still handles all gRPC
# transport internally; you do NOT need the separate google-cloud-aiplatform
# client library.
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Uncomment the following line to switch from AI Studio to Vertex AI endpoint:
# GOOGLE_GENAI_USE_VERTEXAI=true

# The model name defaults to gemini-2.5-flash (see backend/app/constants.py).

# Application port (default: 8000)
# PORT=8000

# -----------------------------------------------------------------------------
# Frontend (Vite / React)
# -----------------------------------------------------------------------------

# Base URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# Firebase Web SDK configuration (from Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: Firebase Measurement ID (for Google Analytics integration)
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
